PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=
# Segredo do JWT de login (mínimo 32 caracteres aleatórios)
JWT_SECRET=
# Origens permitidas no CORS (separadas por vírgula); vazio = padrão do main.ts
CORS_ORIGINS=
# Só use true em desenvolvimento: cria/altera tabelas sozinho
DB_SYNCHRONIZE=false

# Jitsi as a Service (https://jaas.8x8.vc): API Keys
JAAS_APP_ID=
JAAS_KID=
# Chave privada (.pk) em UMA linha, com \n literais no lugar das quebras de linha
JAAS_PRIVATE_KEY=
